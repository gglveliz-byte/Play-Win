{
  "name": "play-win-esports",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma eSports Play Win — Micro-Ligas de 10, Duelos 1v1 en tiempo real y Pasaporte Competitivo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:hub": "npm run dev --prefix apps/hub",
    "dev:realtime": "npm run dev --prefix apps/realtime-server",
    "dev:watch": "node scripts/dev-watch.mjs",
    "sync:sdk": "node scratch/sync_sdk_scripts.mjs",
    "build:hub": "npm run build --prefix apps/hub",
    "start:hub": "npm run start --prefix apps/hub",
    "test:db": "node --env-file=.env.test packages/database/test/services_test.js",
    "test:duel": "node --env-file=.env.test apps/realtime-server/test/duel_test.js",
    "test:treasury": "node --env-file=.env.test apps/hub/test/treasury_and_settle_test.mjs",
    "test:e2e": "node --env-file=.env.test apps/hub/test/e2e_flow_test.mjs",
    "test:anticheat": "node --env-file=.env.test apps/realtime-server/test/anticheat_test.js",
    "test:cyber": "node --env-file=.env.test apps/realtime-server/test/cybersecurity_suite.js",
    "test:email": "node --env-file=.env.test apps/hub/test/email_and_recovery_test.mjs",
    "test:history": "node --env-file=.env.test apps/hub/test/match_history_test.mjs",
    "test:collusion": "node --env-file=.env.test apps/realtime-server/test/collusion_spec.js",
    "test:sdk": "node --env-file=.env.test scripts/simulate-sdk-client.mjs carreras 3001",
    "test:probe": "node --env-file=.env.test scripts/probe-duel-flow.mjs carreras 3001",
    "check:sdk": "node scripts/check-sdk-served.mjs",
    "check:dom": "node scripts/check-game-dom.mjs",
    "test:caidas": "node scripts/test-doble-caida.mjs",
    "test:empate": "node --env-file=.env.test scripts/test-empate-real.mjs 3001",
    "test:sky": "node scripts/test-sky-determinism.mjs && node scripts/test-sky-shadow.mjs && node scripts/test-sky-win-condition.mjs && node scripts/test-sky-physics.mjs && node scripts/test-sky-render.mjs",
    "check:sky": "node scripts/check-sky-modules.mjs && node scripts/check-sky-served.mjs",
    "test:ghost": "node --env-file=.env.test apps/realtime-server/test/ghost-bot_spec.js",
    "test:leagues": "node --env-file=.env.test packages/database/test/league_integrity_spec.js",
    "test:migrate": "node --env-file=.env.test packages/database/src/migrate-league-integrity.mjs",
    "test:migrate:ranks": "node --env-file=.env.test packages/database/src/migrate-rank-tier-trigger.mjs",
    "test:governance": "node test/code_protection_governance_test.mjs",
    "test:all": "npm run test:governance && npm run test:db && npm run test:duel && npm run test:anticheat && npm run test:cyber && npm run test:collusion && npm run test:leagues && npm run test:treasury && npm run test:e2e && npm run test:email && npm run test:history"
  },
  "keywords": [
    "esports",
    "gaming",
    "1v1",
    "realtime",
    "leagues",
    "neon-postgres"
  ],
  "author": "Play Win Team",
  "license": "UNLICENSED"
}
