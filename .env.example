# ==============================================================================
# PLAY WIN eSPORTS — PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# 1. Base de Datos Neon Serverless PostgreSQL (Pooler Mode)
DATABASE_URL="postgresql://user:password@ep-host-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# 2. Seguridad & Autenticación JWT
JWT_SECRET="generate_a_secure_random_64_char_secret_for_production"

# 3. Servidor Realtime WebSockets
PORT=3001
NEXT_PUBLIC_REALTIME_WS_URL="ws://localhost:3001/ws"

# 3b. Rivales de División (Ghost Bots) — 🔴 DESACTIVADOS POR DEFECTO
# Un bot solo entra cuando un jugador real lleva esperando en cola. Están
# apagados por defecto: mientras se valida el emparejamiento entre personas, es
# preferible que nadie juegue contra relleno sin saberlo.
# Para encenderlos hay que pedirlo explícitamente:
GHOST_BOTS_ENABLED="false"     # "true" = activa los bots (pide confirmación antes)
GHOST_BOT_DELAY_MS="10000"     # solo aplica si los bots están encendidos

# 3c. Permitir emparejar al mismo jugador consigo mismo (solo desarrollo/pruebas)
ALLOW_SELF_MATCH="false"

# 4. Whop Payments (Pases y Suscripciones)
WHOP_API_KEY="whop_api_key_here"
WHOP_WEBHOOK_SECRET="whop_webhook_hmac_secret_here"

# 5. PayPal Checkout & Payouts API
PAYPAL_MODE="sandbox" # Cambiar a 'live' en producción
PAYPAL_CLIENT_ID="paypal_client_id_here"
PAYPAL_SECRET="paypal_secret_here"
PAYPAL_WEBHOOK_ID="paypal_webhook_id_here"

# 6. Motor de Cierre Semanal de Ligas (Cron Job)
CRON_SECRET="playwin_weekly_cron_secret_key"
